function createMetricChart(){
  var url = "https://sapi.bntu.by/jour/article/metrics/799";
  
  
  $.get(url, function(data){
    console.log(1);
    var ctx = document.getElementById('metricChart');
    console.log(2);
    if (!data || !data['months'].length) return;
    var chart_data = {
      labels: data['months'],
      datasets: [{
        label: 'Статистика',
        data: data['counts'],
        fill: false,
        borderColor: '#ffb400',
        tension: 0.1
      }]
    };
    
    new Chart(ctx, {
      type: "line",
      data: chart_data
    });
  });
}


