<!DOCTYPE html><!--m8qy5iP4DJrWSilH__742--><html lang="en" class="__variable_0fc2d1"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" href="/_next/static/media/e4af272ccee01ff0-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" as="image" href="/images/logo-v2.png"/><link rel="stylesheet" href="/_next/static/css/f101b2fef284c0e8.css?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/b00e444b8fe651d9.css?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-304a6d2767a6b415.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW"/><script src="/_next/static/chunks/4bd1b696-c023c6e3521b1417.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" async=""></script><script src="/_next/static/chunks/255-165613e09324dad0.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" async=""></script><script src="/_next/static/chunks/main-app-f9b5d20365cb8be2.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" async=""></script><script src="/_next/static/chunks/619-ba102abea3e3d0e4.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" async=""></script><script src="/_next/static/chunks/app/layout-3aa93bfd9ee9b2a3.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" async=""></script><script src="/_next/static/chunks/app/blog/%5Bslug%5D/page-064a66d39876b379.js?dpl=dpl_5nzsZxPFPRAmoSamz6hqMCeyxXkW" async=""></script><meta name="next-size-adjust" content=""/><title>Pipeline Parallelism in SGLang: Scaling to Million-Token Contexts and Beyond - LMSYS Org</title><meta name="description" content="We are excited to introduce SGLang&#x27;s highly optimized Pipeline Parallelism (PP) implementation, specifically engineered to tackle the challenges of ultra-long context inference. By integrating Chunked..."/><meta name="robots" content="index, follow"/><link rel="canonical" href="https://www.lmsys.org/blog/2026-01-15-chunked-pip