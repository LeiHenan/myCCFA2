2\",\"--shiki-light\":\"#CF222E\"},\"children\":\" \\\\\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\"    --decode-context-parallel-size\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\" 2\"}]]}]]}]}]]}]}]\n"])</script><script>self.__next_f.push([1,"42:[\"$\",\"h3\",null,{\"id\":\"53-mla-backend\",\"className\":\"text-xl font-semibold mt-6 mb-2 scroll-mt-24\",\"children\":\"5.3 MLA Backend\"}]\n43:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Models:\"}],\" DeepSeek-V2 / V3 / R1, Kimi K2.6 models using Multi-head Latent Attention.\"]}]\n44:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Why it's different.\"}],\" MLA compresses the Key/Value into a single low-rank \",[\"$\",\"em\",null,{\"children\":\"latent\"}],\" vector that is shared across all query heads — effectively one KV \\\"head.\\\" Under pure tensor parallelism there's nothing to split by head, so that latent KV cache is replicated in full on \",[\"$\",\"em\",null,{\"children\":\"every\"}],\" TP rank. TP does nothing to shrink it, which makes MLA the ideal candidate for DCP: the whole cache is redundant, so the whole cache can be sequence-split.\"]}]\n45:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"What they do.\"}],\" DCP splits the latent KV cache along the sequence dimension, so each rank stores only its chunk of the latent; at attention time each rank up-projects its latent slice (the \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"k_up\"}],\" step) to reconstruct the Keys/Values it needs. Because the effective KV-head count is 1, the sequence can be split up to the full TP degree — hence the constraints:\"]}]\n46:[\"$\",\"ul\",null,{\"className\":\"my-4 ml-6 list-disc space-y-1.5\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"tensor_parallel_size \u003e= decode_context_parallel_size\"}]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"tensor_parallel_size % decode_context_parallel_size == 0\"}]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"47:[\"$\",\"figure\",null,{\"data-rehype-pretty-code-figure\":\"\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative group my-4 rounded-lg border bg-muted/50\",\"children\":[[\"$\",\"$L57\",null,{}],[\"$\",\"pre\",null,{\"className\":\"overflow-x-auto p-4 text-sm [\u0026\u003ecode]:block [\u0026\u003ecode]:w-fit [\u0026\u003ecode]:min-w-full font-mono\",\"style\":\"$undefined\",\"tabIndex\":\"0\",\"data-language\":\"bash\",\"data-theme\":\"github-dark-default github-light-default\",\"children\":[\"$\",\"code\",null,{\"className\":\"$undefined\",\"data-language\":\"bash\",\"data-theme\":\"github-dark-default github-light-default\",\"style\":{\"display\":\"grid\"},\"children\":[[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FFA657\",\"--shiki-light\":\"#953800\"},\"children\":\"vllm\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#A5D6FF\",\"--shiki-light\":\"#0A3069\"},\"children\":\" serve\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#A5D6FF\",\"--shiki-light\":\"#0A3069\"},\"children\":\" deepseek-ai/DeepSeek-R1\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\" \\\\\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\"    --tensor-parallel-size\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\" 8\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\" \\\\\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\"    --decode-context-parallel-size\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\" 8\"}]]}]]}]}]]}]}]\n"])</script><script>self.__next_f.push([1,"48:[\"$\",\"h3\",null,{\"id\":\"54-gqa-backend\",\"className\":\"text-xl font-semibold mt-6 mb-2 scroll-mt-24\",\"children\":\"5.4 GQA Backend\"}]\n49:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Example models:\"}],\" Qwen3-235B, and other Grouped-Query-Attention models (Llama-family, etc.).\"]}]\n"])</script><script>self.__next_f.push([1,"4a:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Why it's different.\"}],\" GQA stores \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"num_key_value_heads\"}],\" KV heads, and TP splits the KV cache by those heads first. That works cleanly only up to \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"num_key_value_heads\"}],\"; once \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"tensor_parallel_size\"}],\" exceeds it, the KV cache begins duplicating, with \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"tp // num_key_value_heads\"}],\" identical copies across ranks.\"]}]\n"])</script><script>self.__next_f.push([1,"4b:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"What they do.\"}],\" DCP takes those would-be-duplicate copies and fills them with \",[\"$\",\"em\",null,{\"children\":\"different\"}],\" sequence chunks instead, while the shared KV heads are broadcast across their query heads (the \\\"tensor broadcast for GQA\\\" step). So the sequence-split degree is capped by the duplication factor \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"tp // num_key_value_heads\"}],\":\"]}]\n4c:[\"$\",\"ul\",null,{\"className\":\"my-4 ml-6 list-disc space-y-1.5\",\"children\":[\"\\n\",[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"(tensor_parallel_size // num_key_value_heads) \u003e= decode_context_parallel_size\"}]}],\"\\n\",[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"(tensor_parallel_size // num_key_value_heads) % decode_context_parallel_size == 0\"}]}],\"\\n\"]}]\n"])</script><script>self.__next_f.push([1,"4d:[\"$\",\"figure\",null,{\"data-rehype-pretty-code-figure\":\"\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative group my-4 rounded-lg border bg-muted/50\",\"children\":[[\"$\",\"$L57\",null,{}],[\"$\",\"pre\",null,{\"className\":\"overflow-x-auto p-4 text-sm [\u0026\u003ecode]:block [\u0026\u003ecode]:w-fit [\u0026\u003ecode]:min-w-full font-mono\",\"style\":\"$undefined\",\"tabIndex\":\"0\",\"data-language\":\"python\",\"data-theme\":\"github-dark-default github-light-default\",\"children\":[\"$\",\"code\",null,{\"className\":\"$undefined\",\"data-language\":\"python\",\"data-theme\":\"github-dark-default github-light-default\",\"style\":{\"display\":\"grid\"},\"children\":[[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#8B949E\",\"--shiki-light\":\"#6E7781\"},\"children\":\"# Qwen3-235B has num_key_value_heads = 4; tp=8 gives 8//4 = 2 redundant copies,\"}]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#8B949E\",\"--shiki-light\":\"#6E7781\"},\"children\":\"# so dcp can be up to 2.\"}]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"vllm serve Qwen\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"/\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"Qwen3\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FFA198\",\"--shiki-dark-font-style\":\"italic\",\"--shiki-light\":\"#82071E\",\"--shiki-light-font-style\":\"italic\"},\"children\":\"235B\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\"A22B\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\" \\\\\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FFA198\",\"--shiki-dark-font-style\":\"italic\",\"--shiki-light\":\"#82071E\",\"--shiki-light-font-style\":\"italic\"},\"children\":\"    --\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"tensor\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"parallel\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"size \"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\"8\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\" \\\\\"}]]}],\"\\n\",[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FFA198\",\"--shiki-dark-font-style\":\"italic\",\"--shiki-light\":\"#82071E\",\"--shiki-light-font-style\":\"italic\"},\"children\":\"    --\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"decode\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"context\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"parallel\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"-\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"size \"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#79C0FF\",\"--shiki-light\":\"#0550AE\"},\"children\":\"2\"}]]}]]}]}]]}]}]\n"])</script><script>self.__next_f.push([1,"4e:[\"$\",\"h2\",null,{\"id\":\"6-future-work\",\"className\":\"text-2xl font-bold mt-8 mb-3 scroll-mt-24\",\"children\":\"6. Future Work\"}]\n5a:T41b,"])</script><script>self.__next_f.push([1,"Looking ahead, we plan to extend DCP along several main directions. We will add support for finer-grained parallelism sizes for both TP and DCP, giving users more precise control over their parallelism layout and reclaiming efficiency lost to over-provisioned sharding. We are also developing better DCP all-to-all (A2A) communication kernels for both multinode and single-node settings, reducing exposed communication and improving overlap with compute as context length and device count grow. We are working on better support for MTP and speculative decoding, so that DCP can deliver its efficiency gains without sacrificing the latency benefits of speculative methods, as well as hardening prefill/decode (P/D) disaggregation support to make DCP robust in disaggregated serving deployments. Finally, we aim to broaden DCP's reach by extending support to a wider variety of backends and integrating it with hybrid models and Dynamic Chunked Pipeline Parallelism, so a much wider range of workloads can benefit from context-parallel efficiency gains."])</script><script>self.__next_f.push([1,"4f:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":\"$5a\"}]\n50:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[\"The community is also expanding DCP to additional models such as GLM-5.2 and Kimi K3, and there is a longer roadmap for Prefill Context Parallelism (PCP). We are working on DCP performance benchmarking for the Kimi K3 model and plan to share those results as that work matures. For deployment guidance and historical notes on DCP, see the \",[\"$\",\"a\",null,{\"href\":\"https://docs.vllm.ai/en/latest/serving/context_parallel_deployment/#decode-context-parallel\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-vllm-blue hover:underline\",\"children\":\"vLLM Decode Context Parallel docs\"}],\".\"]}]\n51:[\"$\",\"h2\",null,{\"id\":\"7-conclusion\",\"className\":\"text-2xl font-bold mt-8 mb-3 scroll-mt-24\",\"children\":\"7. Conclusion\"}]\n52:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":\"Decode Context Parallelism represents a fundamental rethinking of how GPUs are organized for long-context inference. Rather than forcing GPUs to duplicate KV cache or sit underutilized, DCP puts every GPU to work: sharding the sequence during attention, then immediately reconfiguring those same GPUs to amortize FFN weight loading across the full pool. The result is a system that scales gracefully with context length rather than degrading under it.\"}]\n"])</script><script>self.__next_f.push([1,"53:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[\"With native support in vLLM, Decode Context Parallelism is ready to power the next generation of long-context agentic applications, from document reasoning to multi-session agentic pipelines, at the throughput and latency that production demands. It joins a broader industry move toward Decode Context Parallelism, a direction \",[\"$\",\"a\",null,{\"href\":\"https://github.com/NVIDIA/TensorRT-LLM/blob/main/docs/source/blogs/tech_blog/blog22_Helix_Parallelism_Scaling_Multi_Million_Token_Decoding_with_KV_Cache_Sharding.md\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-vllm-blue hover:underline\",\"children\":\"NVIDIA has also pursued with Helix Parallelism\"}],\" in TensorRT-LLM. We are also working on DCP performance benchmarking for the Kimi K3 model and plan to share those results as that work matures.\"]}]\n"])</script><script>self.__next_f.push([1,"54:[\"$\",\"h2\",null,{\"id\":\"about-us\",\"className\":\"text-2xl font-bold mt-8 mb-3 scroll-mt-24\",\"children\":\"About Us\"}]\n"])</script><script>self.__next_f.push([1,"55:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[\"Special thanks to the NVIDIA team Anahita Bhiwandiwalla, Xin Li, Pavani Majety, Nidhi Bhatia, Roman Ageev, Pen Chung Li, and Chris Hoge for their reviews, benchmarking support, and engineering input throughout this study. We also thank \",[\"$\",\"a\",null,{\"href\":\"https://www.moonshot.cn/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-vllm-blue hover:underline\",\"children\":\"Moonshot AI\"}],\" for the initial Decode Context Parallel work upstreamed in \",[\"$\",\"a\",null,{\"href\":\"https://github.com/vllm-project/vllm/pull/23734\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-vllm-blue hover:underline\",\"children\":\"vLLM #23734\"}],\", and \",[\"$\",\"a\",null,{\"href\":\"https://github.com/LucasWilkinson\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-vllm-blue hover:underline\",\"children\":\"Lucas Wilkinson\"}],\" for substantial follow-up contributions that helped harden and extend DCP. We also thank the broader vLLM community, whose open-source engine and continued collaboration made this benchmarking effort possible. For more on DCP deployment and related history, see the \",[\"$\",\"a\",null,{\"href\":\"https://docs.vllm.ai/en/latest/serving/context_parallel_deployment/#decode-context-parallel\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-vllm-blue hover:underline\",\"children\":\"vLLM Decode Context Parallel docs\"}],\".\"]}]\n"])</script><script>self.__next_f.push([1,"56:[\"$\",\"p\",null,{\"className\":\"my-4 leading-relaxed\",\"children\":[\"The DCP results in this post were measured on NVIDIA B200 GPUs with Kimi K2.6 in NVFP4, and the recipes can be reproduced with current vLLM releases that support \",[\"$\",\"code\",null,{\"className\":\"px-1.5 py-0.5 rounded-md bg-muted font-mono text-sm break-all\",\"children\":\"--decode-context-parallel-size\"}],\". We are also working on DCP performance benchmarking for the Kimi K3 model and plan to share those results as that work matures.\"]}]\n1b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n"])</script><script>self.__next_f.push([1,"58:[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\")\"}]}]\n59:[\"$\",\"span\",null,{\"data-line\":\"\",\"children\":[[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\"outputs \"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#FF7B72\",\"--shiki-light\":\"#CF222E\"},\"children\":\"=\"}],[\"$\",\"span\",null,{\"style\":{\"--shiki-dark\":\"#E6EDF3\",\"--shiki-light\":\"#1F2328\"},\"children\":\" llm.generate(prompts, sampling_params)\"}]]}]\n17:null\n"])</script><script>self.__next_f.push([1,"5b:I[9993,[],\"IconMark\"]\n"])</script><script>self.__next_f.push([1,"19:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Efficient Decode Context Parallelism with vLLM for Long Context Workloads | vLLM Blog\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Decode Context Parallelism (DCP) in vLLM shards KV cache across GPUs by sequence dimension, enabling 3× higher throughput on long-context agentic workloads comp\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"vLLM Team\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"vLLM blog,LLM inference,model serving,AI engineering,open source AI\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"vLLM Team\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"vLLM Project\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet: